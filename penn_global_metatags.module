<?php

/**
 * @file
 * Tokens for Penn Global Metatags.
 */

use Drupal\Core\Render\BubbleableMetadata;
use Drupal\node\NodeInterface;

/**
 * Implements hook_token_info().
 */
function penn_global_metatags_token_info() {
  return [
    'tokens' => [
      'current-page' => [
        'schema-breadcrumb' => [
          'name' => t('Schema.org BreadcrumbList'),
          'description' => t("Drupal's breadcrumb plus the current page, serialized for schema_metatag. Empty when under two items."),
        ],
      ],
      'site' => [
        'social-image' => [
          'name' => t('Default social sharing image'),
          'description' => t('Absolute URL of the image set at Configuration > Search and metadata > Penn Global Metatags.'),
        ],
        'social-image-alt' => [
          'name' => t('Default social sharing image alt text'),
        ],
      ],
      'node' => [
        'social-image' => [
          'name' => t('Social sharing image'),
          'description' => t("The site's default sharing image, unless a module sets one for this node with hook_penn_global_metatags_social_image_alter()."),
        ],
        'social-image-alt' => [
          'name' => t('Social sharing image alt text'),
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_tokens().
 */
function penn_global_metatags_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata) {
  $replacements = [];

  if ($type === 'current-page' && isset($tokens['schema-breadcrumb'])) {
    $replacements[$tokens['schema-breadcrumb']] = \Drupal::service('penn_global_metatags.breadcrumb_trail')
      ->build(\Drupal::routeMatch(), $bubbleable_metadata);
  }

  $wants_image = isset($tokens['social-image']) || isset($tokens['social-image-alt']);
  if ($wants_image && ($type === 'site' || ($type === 'node' && !empty($data['node'])))) {
    $image = penn_global_metatags_social_image($type === 'node' ? $data['node'] : NULL, $bubbleable_metadata);

    if (isset($tokens['social-image'])) {
      $replacements[$tokens['social-image']] = $image['url'];
    }
    if (isset($tokens['social-image-alt'])) {
      $replacements[$tokens['social-image-alt']] = $image['alt'];
    }
  }

  return $replacements;
}

/**
 * Returns the image a page shares on social media.
 *
 * Starts from the site's default image, then lets modules change it with
 * hook_penn_global_metatags_social_image_alter().
 *
 * @param \Drupal\node\NodeInterface|null $node
 *   The node being shared, or NULL for site-wide tokens.
 * @param \Drupal\Core\Render\BubbleableMetadata $bubbleable_metadata
 *   Collects the cacheability of whatever the image came from.
 *
 * @return array{url: string, alt: string}
 *   The absolute image URL, or '' for none, and its alt text.
 */
function penn_global_metatags_social_image(?NodeInterface $node, BubbleableMetadata $bubbleable_metadata): array {
  $settings = \Drupal::config('penn_global_metatags.settings');
  $bubbleable_metadata->addCacheableDependency($settings);

  $image = [
    'url' => trim((string) $settings->get('default_image')),
    'alt' => trim((string) $settings->get('default_image_alt')),
  ];
  \Drupal::moduleHandler()->alter('penn_global_metatags_social_image', $image, $node, $bubbleable_metadata);

  $url = penn_global_metatags_absolute_url(trim((string) ($image['url'] ?? '')));
  return [
    'url' => $url,
    'alt' => $url !== '' ? trim((string) ($image['alt'] ?? '')) : '',
  ];
}

/**
 * Resolves an absolute URL, site path or stream URI to an absolute URL.
 *
 * Social sites need an absolute image URL, but the share image setting can
 * hold any of the three.
 */
function penn_global_metatags_absolute_url(string $value): string {
  if ($value === '') {
    return '';
  }
  if (preg_match('#^https?://#i', $value)) {
    return $value;
  }
  if (preg_match('#^[a-z][a-z0-9+.-]*://#i', $value)) {
    return \Drupal::service('file_url_generator')->generateAbsoluteString($value);
  }

  $request = \Drupal::requestStack()->getCurrentRequest();
  if (!$request) {
    return '';
  }

  return $request->getSchemeAndHttpHost() . $request->getBasePath() . '/' . ltrim($value, '/');
}
